FROM golang:1.26.10-alpine AS act-builder

# Build act from source so it uses the patched Go toolchain (CVE-2026-111943)
RUN CGO_ENABLED=0 GOBIN=/out go install -ldflags "-s -w -X main.version=0.2.89" github.com/nektos/act@v0.2.89

FROM docker:29.6.0-dind

ENV DOCKER_HOST=unix:///var/run/docker.sock

RUN apk add --no-cache ca-certificates curl
COPY --from=act-builder /out/act /usr/bin/act

ADD release/linux/amd64/plugin /bin/
ENTRYPOINT ["/usr/local/bin/dockerd-entrypoint.sh", "/bin/plugin"]
