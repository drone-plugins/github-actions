FROM docker:29.6.0-dind

ENV DOCKER_HOST=unix:///var/run/docker.sock

RUN apk add --no-cache ca-certificates curl
RUN curl -fsSL https://raw.githubusercontent.com/nektos/act/v0.2.89/install.sh -o /tmp/install-act.sh \
    && sh /tmp/install-act.sh -b /usr/local/bin v0.2.89 \
    && rm /tmp/install-act.sh

ADD release/linux/arm64/plugin /bin/
ENTRYPOINT ["/usr/local/bin/dockerd-entrypoint.sh", "/bin/plugin"]
